# --- Convex ---
# Printed by `npx convex dev` when you create/select a deployment.
NUXT_PUBLIC_CONVEX_URL=https://your-deployment.convex.cloud

# --- Clerk ---
# From the Clerk dashboard → API Keys.
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
NUXT_CLERK_SECRET_KEY=sk_test_xxx

# Set this one in the CONVEX dashboard (Settings → Environment Variables),
# NOT here. It is the Issuer URL of your Clerk instance, e.g.
# https://your-app.clerk.accounts.dev
# CLERK_JWT_ISSUER_DOMAIN=
